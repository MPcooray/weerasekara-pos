APP_ENV=production
APP_NAME=Tetrova Optical POS
API_V1_PREFIX=/api/v1
SECRET_KEY=generate-a-random-value-with-at-least-48-characters
JWT_ISSUER=tetrova-optical-pos
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

POSTGRES_DB=tetrova_pos
POSTGRES_USER=tetrova_admin
POSTGRES_PASSWORD=generate-a-long-random-admin-database-password
POSTGRES_APP_USER=tetrova_app
POSTGRES_APP_PASSWORD=generate-a-different-long-random-app-password
MIGRATION_DATABASE_URL=postgresql+psycopg://tetrova_admin:URL_ENCODED_ADMIN_PASSWORD@db:5432/tetrova_pos
DATABASE_URL=postgresql+psycopg://tetrova_app:URL_ENCODED_APP_PASSWORD@db:5432/tetrova_pos

DOMAIN=replace-with-your-real-domain
ACME_EMAIL=replace-with-operations-email
CORS_ORIGINS=https://replace-with-your-real-domain
CORS_ORIGIN_REGEX=
TRUSTED_HOSTS=replace-with-your-real-domain
FORWARDED_ALLOW_IPS=172.16.0.0/12

ALLOW_INITIAL_ADMIN_BOOTSTRAP=false
INITIAL_ADMIN_PASSWORD=
INITIAL_TENANT_NAME=Weerasekara Optics
INITIAL_TENANT_SLUG=weerasekara-optics
INITIAL_ADMIN_EMAIL=owner@weerasekara.lk

BACKUP_ENCRYPTION_PASSPHRASE=generate-a-separate-long-random-passphrase
BACKUP_S3_URI=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=
