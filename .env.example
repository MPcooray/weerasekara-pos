APP_ENV=development
APP_NAME=Tetrova Optical POS
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://tetrova:tetrova@db:5432/tetrova_pos
CORS_ORIGINS=http://localhost:5173
# Development automatically permits localhost and 127.0.0.1 on alternate ports.
# Set an explicit regex only when your deployment requires one.
# CORS_ORIGIN_REGEX=
INITIAL_TENANT_NAME=Weerasekara Optics
INITIAL_TENANT_SLUG=weerasekara-optics
INITIAL_ADMIN_EMAIL=owner@weerasekara.lk
INITIAL_ADMIN_PASSWORD=ChangeMe123!
# Production bootstrap remains disabled unless this is explicitly enabled.
ALLOW_INITIAL_ADMIN_BOOTSTRAP=false
VITE_API_URL=http://localhost:8000/api/v1
OPTICAL_POWER_MIN=-30.00
OPTICAL_POWER_MAX=30.00
OPTICAL_ADD_MIN=0.00
OPTICAL_ADD_MAX=6.00
OPTICAL_PD_MIN=20.00
OPTICAL_PD_MAX=90.00
REQUIRE_QUARTER_DIOPTER_STEPS=true

